  "hardware": {
    "V_RANGE": 10.0,
    "DAC_RES": 4095,
    "_comment_cal": "Per-wheel motor cal from encoder run 2026-05-30 (rpm=RPM_PER_VOLT*V+OFFSET, R2=0.99 for V>=0.55). Old single fit 646.59/-101.2 was ~2x too low. Shared keys kept as fallback.",
    "RPM_PER_VOLT": 1265.7,
    "RPM_VOLT_OFFSET": -321.4,
    "RPM_PER_VOLT_LEFT": 1295,
    "RPM_VOLT_OFFSET_LEFT": -354.2,
    "RPM_PER_VOLT_RIGHT": 1289.8,
    "RPM_VOLT_OFFSET_RIGHT": -299.1
  },

  "kinematics": {
    "WHEEL_DIAMETER": 0.18,
    "GEAR_RATIO": 30,
    "SENSOR_LOOKAHEAD_M": 0.076
  },

  "speeds": {
    "MANUAL_TARGET_HIGH_SPEED": 1,
    "MANUAL_TARGET_SLOW_SPEED": 0.5,
    "AUTO_TARGET_HIGH_SPEED": 0.8,
    "AUTO_TARGET_SLOW_SPEED": 0.18,
    "AUTO_TARGET_APPROACH_SPEED": 0.18,
    "ACCEL_RATE": 0.5,
    "DECEL_RATE": 3,
    "APPROACH_DECEL_RATE": 0.4
  },

  "pid_tuning": {
    "_comment_high": "HIGH gains — retuned for 0.6 m/s (was 0.32 m/s: KP=2.8, TD=0.26, V_RED_COEF=2.8, clamp=1000). Start point only — verify on the physical track and adjust.",
    "KP": 2.3,
    "TD": 0.30,
    "N": 20,
    "_comment_slow": "SLOW/corner gains",
    "KP_SLOW": 2.6,
    "TD_SLOW": 0.16,
    "N_SLOW": 12,
    "_comment_approach": "APPROACH gains — 0.2 m/s station crawl. The approach is guided by a one-sided physical bar on the AGV's RIGHT; tape is straight here so the PID needs little authority. Asymmetric clamp: INTO_BAR (positive output = yaw right into the bar) held tight at 8 rpm so the bar centers the AGV mechanically instead of the PID over-pressing the bearings; AWAY (off the bar) kept at 80 rpm for recovery. INTO_BAR is the tuning dial — lower toward 0 if it still binds, raise if it drifts left off the bar.",
    "KP_APPROACH": 0.45,
    "TD_APPROACH": 0.2,
    "N_APPROACH": 10,
    "OUTPUT_CLAMP_INTO_BAR_APPROACH": 8,
    "OUTPUT_CLAMP_AWAY_APPROACH": 80,
    "_comment_shared": "Shared — integral and timing constants. TI/deadband lowered to null corner standing bias faster at higher speed.",
    "TI": 25,
    "TI_DEADBAND": 20,
    "TI_MAX": 400,
    "DT": 0.01,
    "_comment_sr": "Speed reduction coefficients — split by speed mode",
    "V_RED_COEF": 3.6,
    "V_RED_COEF_SLOW": 2.0,
    "V_RED_COEF_APPROACH": 0.4,
    "OUTPUT_CLAMP_RPM": 1300,
    "SR_ALPHA": 0.15,
    "SR_CAP": 0.45
  },

  "can_sensor": {
    "SENSOR_COB_ID": 390,
    "FLAG_TAPE_DETECT": 2,
    "FLAG_LEFT_MARKER": 4,
    "FLAG_RIGHT_MARKER": 8,
    "FLAG_SENSOR_FAIL": 128,
    "CAN_TIMEOUT": 0.5,
    "CAN_NODE_ID": 6,
    "_comment_limits": "Reject |left_mm|>SENSOR_MAX_MM; clamp per-cycle jumps > SENSOR_MAX_STEP_MM",
    "SENSOR_MAX_MM": 100.0,
    "SENSOR_MAX_STEP_MM": 40.0
  },

  "rfid": {
    "RFID_INIT_CMD_HEX": "CFFF0070002415",
    "SEQUENCE_STOP_DELAY": 4.0
  },

  "encoder": {
    "_comment": "CANopen friction-wheel encoder for wheel-speed calibration. Multi-turn: TPDO1 maps 0x6004 (24-bit), wraps at TOTAL_RANGE not per-rev. WHEEL_DIAMETER_M is the encoder friction wheel contact diameter; v_ground = omega_enc * (WHEEL_DIAMETER_M/2).",
    "ENABLED": 1,
    "NODE_ID": 1,
    "BITRATE": 125000,
    "COUNTS_PER_REV": 4096,
    "TOTAL_RANGE": 16777216,
    "WHEEL_DIAMETER_M": 0.060,
    "TPDO_COB_ID_BASE": 384
  },

  "calibration": {
    "_comment": "Open-loop straight ramp for input-vs-actual wheel speed. Shortened ramp (0->0.5 m/s, 2s dwell) to fit ~13 m of straight track.",
    "V_START": 0.0,
    "V_STEP": 0.02,
    "V_MAX": 0.50,
    "DWELL_S": 2.0
  },

  "feedforward": {
    "_comment": "Curvature feedforward for corners: output_ff = FF_SCALE*sign*0.5*base_rpm*(TRACK_WIDTH_M/CURVE_RADIUS_M), applied while speed_mode is a curve mode. Stadium is CCW => all left turns. FF_SCALE=0.5 halves the compensation (2026-05-30).",
    "ENABLED": 1,
    "TRACK_WIDTH_M": 0.46,
    "CURVE_RADIUS_M": 1.5,
    "CURVE_DIRECTION": "left",
    "CURVE_SPEED_MODES": ["SLOW"],
    "FF_ALPHA": 0.15,
    "FF_EXIT_ALPHA": 0.6,
    "FF_SCALE": 0.85
  },

  "sequences": [
    {
      "_comment": "Slow down zone — RFID-only trigger",
      "name": "speed_zone_slow",
      "category": "navigation",
      "trigger": { "type": "rfid", "rfid_tag": "0014" },
      "actions": [
        { "type": "set_speed", "speed": "SLOW" }
      ],
      "cooldown_s": 0.0,
      "requires_mode": "running"
    },
    {
      "_comment": "Resume high speed — RFID-only trigger",
      "name": "speed_zone_high",
      "category": "navigation",
      "trigger": { "type": "rfid", "rfid_tag": "0016" },
      "actions": [
        { "type": "set_speed", "speed": "HIGH" }
      ],
      "cooldown_s": 0.0,
      "requires_mode": "running"
    },
    {
      "_comment": "Slow down zone (alt tag) — RFID-only trigger",
      "name": "speed_zone_slow_alt",
      "category": "navigation",
      "trigger": { "type": "rfid", "rfid_tag": "001C" },
      "actions": [
        { "type": "set_speed", "speed": "SLOW" }
      ],
      "cooldown_s": 0.0,
      "requires_mode": "running"
    },
    {
      "_comment": "Fork ke titik 1 — hanya jalan kalau operator pilih target ini di HMI homepost. Tag placeholder: replace 00AA with the scanned tag.",
      "name": "fork_to_point1",
      "category": "navigation",
      "trigger": { "type": "rfid", "rfid_tag": "00AA", "requires_target": "point_1" },
      "actions": [
        { "type": "set_track", "side": "right" }
      ],
      "cooldown_s": 5.0,
      "requires_mode": "running"
    },
    {
      "_comment": "Fork ke titik 2. Tag placeholder: replace 00AB with the scanned tag.",
      "name": "fork_to_point2",
      "category": "navigation",
      "trigger": { "type": "rfid", "rfid_tag": "00AB", "requires_target": "point_2" },
      "actions": [
        { "type": "set_track", "side": "right" }
      ],
      "cooldown_s": 5.0,
      "requires_mode": "running"
    },
    {
      "_comment": "Fork ke titik 3. Tag placeholder: replace 00AC with the scanned tag.",
      "name": "fork_to_point3",
      "category": "navigation",
      "trigger": { "type": "rfid", "rfid_tag": "00AC", "requires_target": "point_3" },
      "actions": [
        { "type": "set_track", "side": "right" }
      ],
      "cooldown_s": 5.0,
      "requires_mode": "running"
    },
    {
      "_comment": "Fork ke titik 4. Tag placeholder: replace 00AD with the scanned tag.",
      "name": "fork_to_point4",
      "category": "navigation",
      "trigger": { "type": "rfid", "rfid_tag": "00AD", "requires_target": "point_4" },
      "actions": [
        { "type": "set_track", "side": "right" }
      ],
      "cooldown_s": 5.0,
      "requires_mode": "running"
    },
    {
      "_comment": "Fork ke titik 5. Tag placeholder: replace 00AE with the scanned tag.",
      "name": "fork_to_point5",
      "category": "navigation",
      "trigger": { "type": "rfid", "rfid_tag": "00AE", "requires_target": "point_5" },
      "actions": [
        { "type": "set_track", "side": "right" }
      ],
      "cooldown_s": 5.0,
      "requires_mode": "running"
    },
    {
      "_comment": "After the merge back onto the main loop — revert to the default LEFT track. No requires_target: always runs regardless of which point was selected. Tag placeholder: replace 00BB with the scanned tag.",
      "name": "fork_merge_revert",
      "category": "navigation",
      "trigger": { "type": "rfid", "rfid_tag": "00BB" },
      "actions": [
        { "type": "set_track", "side": "left" }
      ],
      "cooldown_s": 5.0,
      "requires_mode": "running"
    },
    {
      "_comment": "Timed checkpoint stop — RFID-only trigger",
      "name": "checkpoint_stop",
      "category": "sequence",
      "trigger": { "type": "rfid", "rfid_tag": "000C" },
      "actions": [
        { "type": "sequence_stop", "duration": 4.0 }
      ],
      "cooldown_s": 0.0,
      "requires_mode": "running"
    },
    {
      "_comment": "Trolley load 0 — RFID arms APPROACH deceleration (0.1 m/s crawl); DI08 magnetic proximity marker triggers the stop.",
      "name": "trolley_load_00",
      "category": "sequence",
      "trigger": {
        "type": "rfid_then_marker",
        "rfid_tag": "0096",
        "marker_side": "prox",
        "approach_timeout": 45.0,
        "approach_speed": "APPROACH"
      },
      "actions": [
        { "type": "set_speed",        "speed": "APPROACH" },
        { "type": "wait_marker",      "side": "prox", "timeout": 45.0 },
        { "type": "stop_agv" },
        { "type": "wait_seconds",     "duration": 1.0 },
        { "type": "plc_request",      "seq_num": 0, "pulse_duration": 1.0 },
        { "type": "wait_plc_complete","seq_num": 0, "clear_timeout": 10.0 },
        { "type": "resume",           "speed": "HIGH" }
      ],
      "cooldown_s": 10.0,
      "requires_mode": "running"
    },
    {
      "name": "trolley_load_01",
      "category": "sequence",
      "trigger": {
        "type": "rfid_then_marker",
        "rfid_tag": "0078",
        "marker_side": "prox",
        "approach_timeout": 30.0
      },
      "actions": [
        { "type": "set_speed",        "speed": "APPROACH" },
        { "type": "wait_marker",      "side": "prox", "timeout": 30.0 },
        { "type": "stop_agv" },
        { "type": "wait_seconds",     "duration": 1.0 },
        { "type": "plc_request",      "seq_num": 1, "pulse_duration": 1.0 },
        { "type": "wait_plc_complete","seq_num": 1, "clear_timeout": 5.0, "done_timeout": 60.0 },
        { "type": "wait_seconds",     "duration": 1.0 },
        { "type": "resume",           "speed": "HIGH" }
      ],
      "cooldown_s": 10.0,
      "requires_mode": "running"
    },
    {
      "name": "trolley_load_02",
      "category": "sequence",
      "trigger": {
        "type": "rfid_then_marker",
        "rfid_tag": "009A",
        "marker_side": "prox",
        "approach_timeout": 15.0
      },
      "actions": [
        { "type": "set_speed",        "speed": "SLOW" },
        { "type": "wait_marker",      "side": "left", "timeout": 15.0 },
        { "type": "stop_agv" },
        { "type": "plc_request",      "seq_num": 2, "pulse_duration": 1.0 },
        { "type": "wait_plc_complete","seq_num": 2, "clear_timeout": 5.0, "done_timeout": 30.0 },
        { "type": "resume",           "speed": "HIGH" }
      ],
      "cooldown_s": 10.0,
      "requires_mode": "running"
    }
  ],

